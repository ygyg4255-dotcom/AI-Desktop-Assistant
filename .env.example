# Anthropic Claude API key (the endpoint is fixed to api.anthropic.com).
# The model defaults to the value in src/config/settings.py; override it
# from the HUD settings panel rather than here.
ANTHROPIC_API_KEY=your_api_key_here

# Telegram Bot Remote Control
# Create a bot via @BotFather on Telegram to obtain your token.
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your numeric Telegram Chat ID
# Retrieve your chat ID by messaging @userinfobot or @raw_data_bot on Telegram.
TELEGRAM_CHAT_ID=your_chat_id_here
