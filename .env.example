# Anthropic Claude API key (the endpoint is fixed to api.anthropic.com).
# The model defaults to the value in src/config/settings.py; override it
# from the HUD settings panel rather than here.
ANTHROPIC_API_KEY=your_api_key_here

# Telegram Bot Remote Control
# Create a bot via @BotFather on Telegram to obtain your token.
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your numeric Telegram Chat ID
# Retrieve your chat ID by messaging @userinfobot or @raw_data_bot on Telegram.
TELEGRAM_CHAT_ID=your_chat_id_here

# Optional: Groq key for fast Whisper speech-to-text (whisper-large-v3-turbo).
# Used ONLY for STT; chat stays on api.anthropic.com. Falls back to local
# faster-whisper when unset or on any error.
# GROQ_API_KEY=

# Optional: force a specific microphone (device index or name fragment).
# By default Altron picks a real mic and skips loopback devices such as
# Stereo Mix, Loopback, What U Hear, Wave Out and Monitor.
# ALTRON_MIC_DEVICE=

# Voice needs the wake word "altron" by default (Alt+R listens without it).
# Set to false to accept all speech.
# ALTRON_REQUIRE_WAKE_WORD=true

# Keep the webcam warm in RAM so "look at this" is instant (default true; skipped with a
# warning if there is no camera or opencv). Frames stay in memory, are never saved to disk
# and are sent to Claude only when you ask Altron to look. The camera LED stays on while
# it runs; say "stop camera" to turn it off, or set this to false.
# ALTRON_CAMERA_AUTOSTART=true

# Voice effect applied locally to speech before playback: "ultron" (default; subtle
# metallic resonance + low-end warmth, still fully intelligible) or "none" to disable.
# ALTRON_VOICE_FX=ultron

# Local Piper TTS (optional; falls back to edge-tts when missing). Defaults to the voices in
# <data dir>/voices (see README "Local voice (Piper)"). Length scale 1.06 is deliberate and slow.
# PIPER_MODEL_PATH=
# PIPER_MODEL_PATH_AR=
# PIPER_LENGTH_SCALE=1.06

# Optional approval PIN (PBKDF2 hash). Set it in the HUD settings, or run: python -m src.security.pin
# With it set, approvals need the PIN (HUD input / Telegram reply) instead of Approve/Deny buttons.
APPROVAL_PIN_HASH=

# AI provider: anthropic (default) | openai | gemini | ollama | custom. Set in the HUD; each provider keeps its own values.
# AI_PROVIDER=anthropic
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# OLLAMA_BASE_URL=http://127.0.0.1:11434   (loopback only)
# OLLAMA_MODEL=qwen2.5-coder:3b
# CUSTOM_BASE_URL=https://api.groq.com/openai/v1   (custom: https, or loopback http)
# CUSTOM_API_KEY=
# CUSTOM_MODEL=

# Speak Telegram-origin replies on the PC speakers (default false)
# ALTRON_TELEGRAM_TTS=false

# Seconds after a PIN-approved gui_hotkey/gui_type/app_open/browser_open_url/browser_switch_tab during which
# those same tools skip approval. 0 disables. Destructive tools always ask. Say "lock" to end it early.
# ALTRON_SESSION_TRUST_SECONDS=180
# Daily Anthropic spend (USD) above which a warning/notice is shown. 0 disables.
# ALTRON_DAILY_BUDGET_USD=0

# Dynamic tool packs: send only core tools, add domain packs (browser, email, office, gaming, dev) on demand and keep them sticky (default true)
# ALTRON_DYNAMIC_TOOLS=true

# Auto-start Brave with remote debugging when the CDP connection fails (local CDP URL only).
# ALTRON_BROWSER_AUTO_LAUNCH=true
# Full path to brave.exe if it is not in a standard install location.
# ALTRON_BRAVE_PATH=
